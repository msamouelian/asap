NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
ASPACE_REPO_ID=11
ASPACE_PAGE_SIZE=100

# ── asapbackend (local dev — asapbackend running on Mac, services in k3d) ────
ASAP_ENV=development
DATABASE_URL=postgresql://asap:your_password_here@localhost:5432/postgres
NEO4J_MCP_URL=http://localhost:8080
NEO4J_MCP_AUTH_USER=neo4j
NEO4J_MCP_AUTH_PASSWORD=your_password_here
# LMStudio (external inference server) — use host.k3d.internal inside the cluster
INFERENCE_BASE_URL=http://localhost:1234/v1
INFERENCE_MODEL=your-model-name-here
INFERENCE_API_KEY=lm-studio

# ── asapui (Vite dev server — npm run dev in packages/asapui) ────────────────
# The backend has no direct ingress (single front door via the UI's /api
# proxy), so leave VITE_BACKEND_URL unset — the Vite dev proxy targets the
# locally-running backend at localhost:8001.
#VITE_BACKEND_URL=
